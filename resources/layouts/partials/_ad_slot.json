{
    "version": "1.0.0",
    "meta": {
        "title": "Ad Slot Partial",
        "description": "예: slot_key=home.top 공개 API를 data_source로 호출 후 static 이미지 링크 렌더. dynamic 타입은 html_content/script_src — XSS 주의, 신뢰된 콘텐츠만."
    },
    "layout_name": "_ad_slot",
    "data_sources": [
        {
            "id": "placements",
            "type": "api",
            "endpoint": "/api/modules/custom-ad_slots/placements",
            "method": "GET",
            "auto_fetch": true,
            "auth_required": false,
            "params": {
                "slot": "{{props.slot_key ?? 'home.top'}}"
            },
            "fallback": {
                "data": []
            }
        }
    ],
    "slots": {
        "content": [
            {
                "id": "ad_slot_items_{{idx}}",
                "type": "basic",
                "name": "Div",
                "props": {
                    "className": "ad-slot ad-slot--{{props.slot_key ?? 'home.top'}}"
                },
                "iteration": {
                    "source": "{{placements?.data ?? []}}",
                    "item_var": "ad",
                    "index_var": "idx"
                },
                "children": [
                    {
                        "id": "ad_static_{{idx}}",
                        "type": "basic",
                        "name": "A",
                        "condition": "{{ad.type === 'static'}}",
                        "props": {
                            "href": "{{ad.link_url ?? '#'}}",
                            "className": "ad-slot__static block",
                            "target": "_blank",
                            "rel": "noopener noreferrer"
                        },
                        "children": [
                            {
                                "type": "basic",
                                "name": "Img",
                                "props": {
                                    "src": "{{ad.image_url ?? ''}}",
                                    "alt": "{{ad.title ?? ''}}",
                                    "className": "ad-slot__image w-full h-auto"
                                }
                            }
                        ]
                    },
                    {
                        "id": "ad_dynamic_note_{{idx}}",
                        "type": "basic",
                        "name": "Div",
                        "condition": "{{ad.type === 'dynamic'}}",
                        "props": {
                            "className": "ad-slot__dynamic text-xs text-amber-700 bg-amber-50 p-2 rounded"
                        },
                        "text": "[dynamic] html_content/script_src 는 XSS 위험이 있습니다. 레이아웃에서 raw HTML 렌더 시 반드시 sanitize 하거나 신뢰된 관리자 입력만 허용하세요. title={{ad.title ?? ''}}"
                    }
                ]
            }
        ]
    }
}
