{
  "meta": {
    "is_partial": true,
    "description": "global.top Bunjang-style hero carousel. Markup + data-cas-hero; hero-carousel.js enhances (official theme has no AdHeroCarousel)."
  },
  "type": "basic",
  "name": "Div",
  "props": {
    "className": "relative w-full overflow-hidden rounded-xl",
    "data-cas-hero": "1",
    "role": "region",
    "aria-roledescription": "carousel",
    "aria-label": "ads"
  },
  "iteration": {
    "source": "{{ad_global_top.data ?? ad_global_top ?? []}}",
    "item_var": "ad"
  },
  "children": [
    {
      "type": "basic",
      "name": "Div",
      "if": "{{(ad.type ?? 'static') === 'static' && (ad.image_desktop ?? ad.image_url_desktop ?? ad.image_url ?? ad.image_mobile ?? ad.image_url_mobile)}}",
      "props": {
        "className": "w-full h-full",
        "data-cas-slide": "1",
        "data-prevent-right-click": "{{ad.prevent_right_click ? '1' : ''}}"
      },
      "children": [
        {
          "comment": "static: 이미지 배너 (link_url, 새 창) — desktop/mobile/legacy",
          "type": "basic",
          "name": "A",
          "if": "{{(ad.type ?? 'static') === 'static' && (ad.image_desktop ?? ad.image_url_desktop ?? ad.image_url ?? ad.image_mobile ?? ad.image_url_mobile) && ad.link_url && (ad.open_in_new_tab ?? true)}}",
          "props": {
            "href": "{{ad.link_url}}",
            "target": "_blank",
            "rel": "noopener noreferrer",
            "className": "absolute inset-0 block w-full h-full",
            "title": "{{ad.title ?? ''}}"
          },
          "children": [
            {
              "type": "basic",
              "name": "Img",
              "props": {
                "src": "{{ad.image_desktop ?? ad.image_url_desktop ?? ad.image_url}}",
                "alt": "{{ad.title ?? 'ad'}}",
                "className": "hidden md:block absolute inset-0 w-full h-full object-cover",
                "preventRightClick": "{{!!ad.prevent_right_click}}",
                "draggable": false
              }
            },
            {
              "type": "basic",
              "name": "Img",
              "props": {
                "src": "{{ad.image_mobile ?? ad.image_url_mobile ?? ad.image_desktop ?? ad.image_url_desktop ?? ad.image_url}}",
                "alt": "{{ad.title ?? 'ad'}}",
                "className": "block md:hidden absolute inset-0 w-full h-full object-cover",
                "preventRightClick": "{{!!ad.prevent_right_click}}",
                "draggable": false
              }
            }
          ]
        },
        {
          "comment": "static: 이미지 배너 (link_url, 현재 창) — desktop/mobile/legacy",
          "type": "basic",
          "name": "A",
          "if": "{{(ad.type ?? 'static') === 'static' && (ad.image_desktop ?? ad.image_url_desktop ?? ad.image_url ?? ad.image_mobile ?? ad.image_url_mobile) && ad.link_url && !(ad.open_in_new_tab ?? true)}}",
          "props": {
            "href": "{{ad.link_url}}",
            "className": "absolute inset-0 block w-full h-full",
            "title": "{{ad.title ?? ''}}"
          },
          "children": [
            {
              "type": "basic",
              "name": "Img",
              "props": {
                "src": "{{ad.image_desktop ?? ad.image_url_desktop ?? ad.image_url}}",
                "alt": "{{ad.title ?? 'ad'}}",
                "className": "hidden md:block absolute inset-0 w-full h-full object-cover",
                "preventRightClick": "{{!!ad.prevent_right_click}}",
                "draggable": false
              }
            },
            {
              "type": "basic",
              "name": "Img",
              "props": {
                "src": "{{ad.image_mobile ?? ad.image_url_mobile ?? ad.image_desktop ?? ad.image_url_desktop ?? ad.image_url}}",
                "alt": "{{ad.title ?? 'ad'}}",
                "className": "block md:hidden absolute inset-0 w-full h-full object-cover",
                "preventRightClick": "{{!!ad.prevent_right_click}}",
                "draggable": false
              }
            }
          ]
        },
        {
          "comment": "static: 이미지만 (링크 없음)",
          "type": "basic",
          "name": "Div",
          "if": "{{(ad.type ?? 'static') === 'static' && (ad.image_desktop ?? ad.image_url_desktop ?? ad.image_url ?? ad.image_mobile ?? ad.image_url_mobile) && !ad.link_url}}",
          "props": {
            "className": "absolute inset-0 w-full h-full"
          },
          "children": [
            {
              "type": "basic",
              "name": "Img",
              "props": {
                "src": "{{ad.image_desktop ?? ad.image_url_desktop ?? ad.image_url}}",
                "alt": "{{ad.title ?? 'ad'}}",
                "className": "hidden md:block absolute inset-0 w-full h-full object-cover",
                "preventRightClick": "{{!!ad.prevent_right_click}}",
                "draggable": false
              }
            },
            {
              "type": "basic",
              "name": "Img",
              "props": {
                "src": "{{ad.image_mobile ?? ad.image_url_mobile ?? ad.image_desktop ?? ad.image_url_desktop ?? ad.image_url}}",
                "alt": "{{ad.title ?? 'ad'}}",
                "className": "block md:hidden absolute inset-0 w-full h-full object-cover",
                "preventRightClick": "{{!!ad.prevent_right_click}}",
                "draggable": false
              }
            }
          ]
        }
      ]
    }
  ]
}
