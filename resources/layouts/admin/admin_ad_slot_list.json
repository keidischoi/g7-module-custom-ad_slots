{
    "version": "1.0.4",
    "meta": {
        "title": "$t:custom-ad_slots.admin.ads.index.title",
        "description": "$t:custom-ad_slots.admin.ads.index.description"
    },
    "layout_name": "admin_ad_slot_list",
    "permissions": [
        "custom-ad_slots.ads.read"
    ],
    "extends": "_admin_base",
    "data_sources": [
        {
            "id": "ads",
            "type": "api",
            "endpoint": "/api/modules/custom-ad_slots/admin/ads",
            "method": "GET",
            "auto_fetch": true,
            "auth_required": true,
            "params": {
                "page": "{{query.page}}",
                "per_page": "{{query.per_page ?? 20}}",
                "slot_key": "{{query.slot_key ?? ''}}",
                "type": "{{query.type ?? ''}}"
            },
            "fallback": {
                "data": {
                    "data": [],
                    "meta": {
                        "current_page": 1,
                        "last_page": 1,
                        "per_page": 20,
                        "total": 0
                    },
                    "slot_keys": []
                }
            }
        }
    ],
    "slots": {
        "content": [
            {
                "id": "ad_slot_list_wrapper",
                "type": "basic",
                "name": "Div",
                "props": {
                    "className": "admin-page-content"
                },
                "children": [
                    {
                        "id": "ad_slot_list_header",
                        "type": "basic",
                        "name": "Div",
                        "props": {
                            "className": "flex items-center justify-between mb-6 gap-3 flex-wrap"
                        },
                        "children": [
                            {
                                "type": "basic",
                                "name": "Div",
                                "children": [
                                    {
                                        "id": "ad_slot_list_title",
                                        "type": "basic",
                                        "name": "H1",
                                        "props": {
                                            "className": "text-2xl font-bold text-gray-900 dark:text-white"
                                        },
                                        "text": "$t:custom-ad_slots.admin.ads.index.title"
                                    },
                                    {
                                        "type": "basic",
                                        "name": "P",
                                        "props": {
                                            "className": "mt-1 text-sm text-gray-500 dark:text-gray-400"
                                        },
                                        "text": "$t:custom-ad_slots.admin.ads.index.description"
                                    }
                                ]
                            },
                            {
                                "id": "ad_slot_create_button",
                                "type": "basic",
                                "name": "Button",
                                "props": {
                                    "type": "button",
                                    "className": "px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm font-medium"
                                },
                                "actions": [
                                    {
                                        "type": "click",
                                        "handler": "navigate",
                                        "params": {
                                            "path": "/admin/ad-slots/create",
                                            "mergeQuery": true,
                                            "query": {}
                                        }
                                    }
                                ],
                                "children": [
                                    {
                                        "type": "basic",
                                        "name": "Span",
                                        "text": "광고 추가"
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "id": "ad_slot_empty_state",
                        "type": "basic",
                        "name": "Div",
                        "if": "{{!(ads?.data?.data ?? []).length}}",
                        "props": {
                            "className": "p-8 text-center bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 text-gray-600 dark:text-gray-300"
                        },
                        "children": [
                            {
                                "type": "basic",
                                "name": "P",
                                "text": "$t:custom-ad_slots.admin.ads.index.empty"
                            }
                        ]
                    },
                    {
                        "id": "ad_items_{{idx}}",
                        "type": "basic",
                        "name": "Div",
                        "if": "{{(ads?.data?.data ?? []).length > 0}}",
                        "props": {
                            "className": "flex flex-col gap-3"
                        },
                        "iteration": {
                            "source": "{{ads?.data?.data ?? []}}",
                            "item_var": "ad",
                            "index_var": "idx"
                        },
                        "children": [
                            {
                                "id": "ad_item_{{idx}}",
                                "type": "basic",
                                "name": "Div",
                                "props": {
                                    "className": "p-4 bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 shadow-sm"
                                },
                                "children": [
                                    {
                                        "type": "basic",
                                        "name": "Div",
                                        "props": {
                                            "className": "flex items-start gap-4"
                                        },
                                        "children": [
                                            {
                                                "comment": "썸네일",
                                                "type": "basic",
                                                "name": "Div",
                                                "props": {
                                                    "className": "w-24 h-16 shrink-0 rounded-md overflow-hidden bg-gray-100 dark:bg-gray-700 border border-gray-200 dark:border-gray-600 flex items-center justify-center"
                                                },
                                                "children": [
                                                    {
                                                        "type": "basic",
                                                        "name": "Img",
                                                        "if": "{{!!(ad.thumb_url ?? ad.image_desktop ?? ad.image_url_desktop ?? ad.image_url)}}",
                                                        "props": {
                                                            "src": "{{ad.thumb_url ?? ad.image_desktop ?? ad.image_url_desktop ?? ad.image_url}}",
                                                            "alt": "{{ad.title ?? ad.slot_key}}",
                                                            "className": "w-full h-full object-cover"
                                                        }
                                                    },
                                                    {
                                                        "type": "basic",
                                                        "name": "Span",
                                                        "if": "{{!(ad.thumb_url ?? ad.image_desktop ?? ad.image_url_desktop ?? ad.image_url)}}",
                                                        "props": {
                                                            "className": "text-xs text-gray-400 dark:text-gray-500"
                                                        },
                                                        "text": "No image"
                                                    }
                                                ]
                                            },
                                            {
                                                "type": "basic",
                                                "name": "Div",
                                                "props": {
                                                    "className": "flex-1 min-w-0"
                                                },
                                                "children": [
                                                    {
                                                        "type": "basic",
                                                        "name": "Div",
                                                        "props": {
                                                            "className": "flex items-center gap-2 flex-wrap"
                                                        },
                                                        "children": [
                                                            {
                                                                "type": "basic",
                                                                "name": "H2",
                                                                "props": {
                                                                    "className": "text-base font-semibold text-gray-900 dark:text-white truncate"
                                                                },
                                                                "text": "{{ad.title || ad.slot_label || ad.slot_key || '(제목 없음)'}}"
                                                            },
                                                            {
                                                                "type": "basic",
                                                                "name": "Span",
                                                                "if": "{{ad.is_active}}",
                                                                "props": {
                                                                    "className": "inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-black dark:bg-gray-700 dark:text-white"
                                                                },
                                                                "text": "활성"
                                                            },
                                                            {
                                                                "type": "basic",
                                                                "name": "Span",
                                                                "if": "{{!ad.is_active}}",
                                                                "props": {
                                                                    "className": "inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-600 dark:bg-gray-700 dark:text-gray-300"
                                                                },
                                                                "text": "비활성"
                                                            }
                                                        ]
                                                    },
                                                    {
                                                        "type": "basic",
                                                        "name": "P",
                                                        "props": {
                                                            "className": "mt-1 text-sm text-gray-600 dark:text-gray-400"
                                                        },
                                                        "text": "{{ad.slot_label || ad.slot_key}} · {{ad.type_label || ad.type}} · 정렬 {{ad.sort_order}}"
                                                    },
                                                    {
                                                        "type": "basic",
                                                        "name": "P",
                                                        "if": "{{!!ad.link_url}}",
                                                        "props": {
                                                            "className": "mt-0.5 text-xs text-gray-400 dark:text-gray-500 truncate"
                                                        },
                                                        "text": "{{ad.link_url}}"
                                                    }
                                                ]
                                            },
                                            {
                                                "type": "basic",
                                                "name": "Div",
                                                "props": {
                                                    "className": "flex gap-2 flex-wrap shrink-0"
                                                },
                                                "children": [
                                                    {
                                                        "type": "basic",
                                                        "name": "Button",
                                                        "props": {
                                                            "type": "button",
                                                            "className": "px-3 py-1.5 text-sm font-medium rounded-md bg-gray-100 text-gray-800 hover:bg-gray-200 dark:bg-gray-700 dark:text-gray-100 dark:hover:bg-gray-600"
                                                        },
                                                        "actions": [
                                                            {
                                                                "type": "click",
                                                                "handler": "navigate",
                                                                "params": {
                                                                    "path": "/admin/ad-slots/{{ad.id}}/edit",
                                                                    "mergeQuery": true,
                                                                    "query": {}
                                                                }
                                                            }
                                                        ],
                                                        "children": [
                                                            {
                                                                "type": "basic",
                                                                "name": "Span",
                                                                "text": "수정"
                                                            }
                                                        ]
                                                    },
                                                    {
                                                        "type": "basic",
                                                        "name": "Button",
                                                        "props": {
                                                            "type": "button",
                                                            "className": "px-3 py-1.5 text-sm font-medium rounded-md bg-violet-50 text-violet-800 hover:bg-violet-100 dark:bg-violet-900/30 dark:text-violet-200 dark:hover:bg-violet-900/50"
                                                        },
                                                        "actions": [
                                                            {
                                                                "type": "click",
                                                                "handler": "apiCall",
                                                                "auth_required": true,
                                                                "target": "/api/modules/custom-ad_slots/admin/ads/{{ad.id}}/duplicate",
                                                                "params": {
                                                                    "method": "POST"
                                                                },
                                                                "onSuccess": [
                                                                    {
                                                                        "handler": "toast",
                                                                        "params": {
                                                                            "type": "success",
                                                                            "message": "$t:custom-ad_slots.admin.ads.index.duplicate_success"
                                                                        }
                                                                    },
                                                                    {
                                                                        "handler": "refetchDataSource",
                                                                        "params": {
                                                                            "dataSourceId": "ads"
                                                                        }
                                                                    }
                                                                ],
                                                                "onError": [
                                                                    {
                                                                        "handler": "toast",
                                                                        "params": {
                                                                            "type": "error",
                                                                            "message": "{{error.message}}"
                                                                        }
                                                                    }
                                                                ]
                                                            }
                                                        ],
                                                        "children": [
                                                            {
                                                                "type": "basic",
                                                                "name": "Span",
                                                                "text": "복제"
                                                            }
                                                        ]
                                                    },
                                                    {
                                                        "type": "basic",
                                                        "name": "Button",
                                                        "props": {
                                                            "type": "button",
                                                            "className": "px-3 py-1.5 text-sm font-medium rounded-md bg-blue-50 text-blue-700 hover:bg-blue-100 dark:bg-blue-900/30 dark:text-blue-300 dark:hover:bg-blue-900/50"
                                                        },
                                                        "actions": [
                                                            {
                                                                "type": "click",
                                                                "handler": "apiCall",
                                                                "auth_required": true,
                                                                "target": "/api/modules/custom-ad_slots/admin/ads/{{ad.id}}/toggle",
                                                                "params": {
                                                                    "method": "PATCH"
                                                                },
                                                                "onSuccess": [
                                                                    {
                                                                        "handler": "toast",
                                                                        "params": {
                                                                            "type": "success",
                                                                            "message": "$t:custom-ad_slots.admin.ads.index.toggle_success"
                                                                        }
                                                                    },
                                                                    {
                                                                        "handler": "refetchDataSource",
                                                                        "params": {
                                                                            "dataSourceId": "ads"
                                                                        }
                                                                    }
                                                                ],
                                                                "onError": [
                                                                    {
                                                                        "handler": "toast",
                                                                        "params": {
                                                                            "type": "error",
                                                                            "message": "{{error.message}}"
                                                                        }
                                                                    }
                                                                ]
                                                            }
                                                        ],
                                                        "children": [
                                                            {
                                                                "type": "basic",
                                                                "name": "Span",
                                                                "text": "활성 전환"
                                                            }
                                                        ]
                                                    },
                                                    {
                                                        "type": "basic",
                                                        "name": "Button",
                                                        "props": {
                                                            "type": "button",
                                                            "className": "px-3 py-1.5 text-sm font-medium rounded-md bg-red-50 text-red-700 hover:bg-red-100 dark:bg-red-900/30 dark:text-red-300 dark:hover:bg-red-900/50"
                                                        },
                                                        "actions": [
                                                            {
                                                                "type": "click",
                                                                "handler": "apiCall",
                                                                "auth_required": true,
                                                                "target": "/api/modules/custom-ad_slots/admin/ads/{{ad.id}}",
                                                                "params": {
                                                                    "method": "DELETE"
                                                                },
                                                                "onSuccess": [
                                                                    {
                                                                        "handler": "toast",
                                                                        "params": {
                                                                            "type": "success",
                                                                            "message": "$t:custom-ad_slots.admin.ads.index.delete_success"
                                                                        }
                                                                    },
                                                                    {
                                                                        "handler": "refetchDataSource",
                                                                        "params": {
                                                                            "dataSourceId": "ads"
                                                                        }
                                                                    }
                                                                ],
                                                                "onError": [
                                                                    {
                                                                        "handler": "toast",
                                                                        "params": {
                                                                            "type": "error",
                                                                            "message": "{{error.message}}"
                                                                        }
                                                                    }
                                                                ]
                                                            }
                                                        ],
                                                        "children": [
                                                            {
                                                                "type": "basic",
                                                                "name": "Span",
                                                                "text": "삭제"
                                                            }
                                                        ]
                                                    }
                                                ]
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    }
}
