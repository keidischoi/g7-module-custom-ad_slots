{
    "version": "1.0.0",
    "routes": [
        {
            "path": "*/admin/ad-slots",
            "layout": "admin_ad_slot_list",
            "auth_required": true,
            "meta": {
                "title": "$t:custom-ad_slots.admin.ads.index.title"
            }
        },
        {
            "path": "*/admin/ad-slots/create",
            "layout": "admin_ad_slot_form",
            "auth_required": true,
            "meta": {
                "title": "$t:custom-ad_slots.admin.ads.form.title_create"
            }
        },
        {
            "path": "*/admin/ad-slots/placements",
            "layout": "admin_ad_slot_placement_list",
            "auth_required": true,
            "meta": {
                "title": "$t:custom-ad_slots.admin.placements.index.title"
            }
        },
        {
            "path": "*/admin/ad-slots/placements/:slotKey/edit",
            "layout": "admin_ad_slot_placement_form",
            "auth_required": true,
            "meta": {
                "title": "$t:custom-ad_slots.admin.placements.form.title_edit"
            }
        },
        {
            "path": "*/admin/ad-slots/:id/edit",
            "layout": "admin_ad_slot_form_edit",
            "auth_required": true,
            "meta": {
                "title": "$t:custom-ad_slots.admin.ads.form.title_edit"
            }
        }
    ]
}
