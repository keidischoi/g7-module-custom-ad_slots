{
  "_comment": "공식 테마 shop/index: shop.list.top prepend + shop.list.bottom append (stacked banners)",
  "target_layout": "shop/index",
  "priority": 85,
  "data_sources": [
    {
      "id": "ad_shop_list_top",
      "label_key": "Ad shop.list.top",
      "type": "api",
      "endpoint": "/api/modules/custom-ad_slots/placements",
      "method": "GET",
      "auto_fetch": true,
      "auth_mode": "optional",
      "loading_strategy": "progressive",
      "params": {
        "slot": "shop.list.top"
      },
      "fallback": {
        "data": []
      },
      "errorHandling": {
        "404": {
          "handler": "suppress",
          "comment": "모듈 미설치 시 조용히 무시"
        },
        "500": {
          "handler": "suppress"
        }
      },
      "comment": "custom-ad_slots shop.list.top"
    },
    {
      "id": "ad_shop_list_bottom",
      "label_key": "Ad shop.list.bottom",
      "type": "api",
      "endpoint": "/api/modules/custom-ad_slots/placements",
      "method": "GET",
      "auto_fetch": true,
      "auth_mode": "optional",
      "loading_strategy": "progressive",
      "params": {
        "slot": "shop.list.bottom"
      },
      "fallback": {
        "data": []
      },
      "errorHandling": {
        "404": {
          "handler": "suppress",
          "comment": "모듈 미설치 시 조용히 무시"
        },
        "500": {
          "handler": "suppress"
        }
      },
      "comment": "custom-ad_slots shop.list.bottom"
    }
  ],
  "injections": [
    {
      "target_id": "main_content",
      "position": "prepend_child",
      "components": [
        {
          "id": "ad_shop_list_top_wrap",
          "comment": "Ad slot: shop.list.top — API mount",
          "type": "basic",
          "name": "Div",
          "props": {
            "className": "mb-6 flex flex-col gap-3",
            "data-cas-ad-slot": "shop.list.top",
            "id": "ad_shop_list_top_wrap"
          },
          "children": [],
          "if": "{{((ad_shop_list_top.data ?? ad_shop_list_top ?? []).length > 0)}}"
        }
      ]
    },
    {
      "target_id": "main_content",
      "position": "append_child",
      "components": [
        {
          "id": "ad_shop_list_bottom_wrap",
          "comment": "Ad slot: shop.list.bottom — API mount",
          "type": "basic",
          "name": "Div",
          "props": {
            "className": "mt-6 flex flex-col gap-3",
            "data-cas-ad-slot": "shop.list.bottom",
            "id": "ad_shop_list_bottom_wrap"
          },
          "children": [],
          "if": "{{((ad_shop_list_bottom.data ?? ad_shop_list_bottom ?? []).length > 0)}}"
        }
      ]
    }
  ]
}
