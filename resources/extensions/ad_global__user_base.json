{
  "_comment": "공식 sirsoft-basic _user_base: global.top/bottom + ALWAYS-ON page mounts (data-cas-ad-role). JS path-routes page slots. No if on API length — JS hides empty mounts. home.mid still Event Hook.",
  "target_layout": "_user_base",
  "priority": 80,
  "data_sources": [
    {
      "id": "ad_global_top",
      "label_key": "Ad global.top",
      "type": "api",
      "endpoint": "/api/modules/custom-ad_slots/placements",
      "method": "GET",
      "auto_fetch": true,
      "auth_mode": "optional",
      "loading_strategy": "progressive",
      "params": {
        "slot": "global.top"
      },
      "fallback": {
        "data": []
      },
      "errorHandling": {
        "404": {
          "handler": "suppress",
          "comment": "모듈 미설치 시 조용히 무시"
        },
        "500": {
          "handler": "suppress"
        }
      },
      "comment": "전역 상단 광고 — 모든 _user_base 페이지"
    },
    {
      "id": "ad_global_bottom",
      "label_key": "Ad global.bottom",
      "type": "api",
      "endpoint": "/api/modules/custom-ad_slots/placements",
      "method": "GET",
      "auto_fetch": true,
      "auth_mode": "optional",
      "loading_strategy": "progressive",
      "params": {
        "slot": "global.bottom"
      },
      "fallback": {
        "data": []
      },
      "errorHandling": {
        "404": {
          "handler": "suppress",
          "comment": "모듈 미설치 시 조용히 무시"
        },
        "500": {
          "handler": "suppress"
        }
      },
      "comment": "전역 하단 광고 — 푸터 직전, 모든 _user_base 페이지"
    }
  ],
