          "name": "Div",
          "props": {
            "className": "w-full"
          },
          "children": [
            {
              "type": "layout",
              "name": "Container",
              "props": {
                "className": "px-4 pt-4"
              },
              "responsive": {
                "desktop": {
                  "props": {
                    "className": "max-w-7xl mx-auto px-8 pt-6"
                  }
                }
              },
              "children": [
                {
                  "id": "ad_global_top_hero",
                  "comment": "global.top hero API mount",
                  "type": "basic",
                  "name": "Div",
                  "props": {
                    "className": "relative w-full overflow-hidden rounded-xl mb-2",
                    "data-cas-ad-slot": "global.top",
                    "id": "ad_global_top_hero",
                    "data-cas-hero": "1",
                    "data-cas-hero-slot": "global.top"
                  },
                  "children": []
                },
                {
                  "id": "cas_page_top_mount",
                  "comment": "Path-routed page top mount (home/shop/board/mypage) — always present; JS fills by URL",
                  "type": "basic",
                  "name": "Div",
                  "props": {
                    "className": "relative w-full mb-4",
                    "id": "cas_page_top_mount",
                    "data-cas-ad-role": "page-top"
                  },
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "target_id": "footer",
      "position": "prepend",
      "components": [
        {
          "id": "ad_global_bottom_wrap",
