{
  "_comment": "공식 테마 home: main_content에 home.top(prepend·hero carousel)·home.bottom(append·stack). home.mid는 Event Hook 삽입.",
  "target_layout": "home",
  "priority": 85,
  "data_sources": [
    {
      "id": "ad_home_top",
      "label_key": "Ad home.top",
      "type": "api",
      "endpoint": "/api/modules/custom-ad_slots/placements",
      "method": "GET",
      "auto_fetch": true,
      "auth_mode": "optional",
      "loading_strategy": "progressive",
      "params": {
        "slot": "home.top"
      },
      "fallback": {
        "data": []
      },
      "errorHandling": {
        "404": {
          "handler": "suppress",
          "comment": "모듈 미설치 시 조용히 무시"
        },
        "500": {
          "handler": "suppress"
        }
      },
      "comment": "custom-ad_slots home.top"
    },
    {
      "id": "ad_home_mid",
      "label_key": "Ad home.mid",
      "type": "api",
      "endpoint": "/api/modules/custom-ad_slots/placements",
      "method": "GET",
      "auto_fetch": true,
      "auth_mode": "optional",
      "loading_strategy": "progressive",
      "params": {
        "slot": "home.mid"
      },
      "fallback": {
        "data": []
      },
      "errorHandling": {
        "404": {
          "handler": "suppress",
          "comment": "모듈 미설치 시 조용히 무시"
        },
        "500": {
          "handler": "suppress"
        }
      },
      "comment": "custom-ad_slots home.mid — Event Hook inserts UI"
    },
    {
      "id": "ad_home_bottom",
      "label_key": "Ad home.bottom",
      "type": "api",
      "endpoint": "/api/modules/custom-ad_slots/placements",
      "method": "GET",
      "auto_fetch": true,
      "auth_mode": "optional",
      "loading_strategy": "progressive",
      "params": {
        "slot": "home.bottom"
      },
      "fallback": {
        "data": []
      },
      "errorHandling": {
        "404": {
          "handler": "suppress",
          "comment": "모듈 미설치 시 조용히 무시"
        },
        "500": {
          "handler": "suppress"
        }
      },
      "comment": "custom-ad_slots home.bottom"
    }
  ],
  "injections": [
    {
      "target_id": "main_content",
      "position": "prepend_child",
      "components": [
        {
          "id": "ad_home_top_wrap",
          "comment": "=== Ad slot: home.top — API mount; hero-carousel.js carousel ===",
          "type": "basic",
          "name": "Div",
          "props": {
            "className": "relative w-full overflow-hidden rounded-xl mb-4",
            "data-cas-ad-slot": "home.top",
            "id": "ad_home_top_wrap",
            "data-cas-hero": "1",
            "data-cas-hero-slot": "home.top"
          },
          "children": [],
          "if": "{{((ad_home_top.data ?? ad_home_top ?? []).length > 0)}}"
        }
      ]
    },
    {
      "target_id": "main_content",
      "position": "append_child",
      "components": [
        {
          "id": "ad_home_bottom_wrap",
          "comment": "=== Ad slot: home.bottom — API mount; stacked banners ===",
          "type": "basic",
          "name": "Div",
          "props": {
            "className": "mt-4 flex flex-col gap-3",
            "data-cas-ad-slot": "home.bottom",
            "id": "ad_home_bottom_wrap"
          },
          "children": [],
          "if": "{{((ad_home_bottom.data ?? ad_home_bottom ?? []).length > 0)}}"
        }
      ]
    }
  ]
}
