    {
      "target_id": "main_content",
      "position": "prepend_child",
      "components": [
        {
          "id": "ad_shop_detail_top_wrap",
          "comment": "Ad slot: shop.detail.top",
          "type": "basic",
          "name": "Div",
          "if": "{{((ad_shop_detail_top.data ?? ad_shop_detail_top ?? []).length > 0)}}",
          "props": {
            "className": "mb-4 flex flex-col gap-3"
          },
          "iteration": {
            "source": "{{(ad_shop_detail_top.data ?? ad_shop_detail_top ?? [])}}",
            "item_var": "ad"
          },
          "children": [
            {
              "type": "basic",
              "name": "Div",
              "props": {
                "className": "w-full overflow-hidden rounded-lg"
              },
              "children": [
                {
                  "comment": "static: 이미지 배너 (link_url, 새 창) — desktop/mobile/legacy",
                  "type": "basic",
                  "name": "A",
                  "if": "{{(ad.type ?? 'static') === 'static' && (ad.image_desktop ?? ad.image_url_desktop ?? ad.image_url ?? ad.image_mobile ?? ad.image_url_mobile) && ad.link_url && (ad.open_in_new_tab ?? true)}}",
                  "props": {
                    "href": "{{ad.link_url}}",
                    "target": "_blank",
                    "rel": "noopener noreferrer",
                    "className": "block w-full",
                    "title": "{{ad.title ?? ''}}"
                  },
                  "children": [
                    {
                      "type": "basic",
                      "name": "Img",
                      "props": {
                        "src": "{{ad.image_desktop ?? ad.image_url_desktop ?? ad.image_url}}",
                        "alt": "{{ad.title ?? 'ad'}}",
                        "className": "hidden md:block w-full h-auto object-cover rounded-lg",
                        "preventRightClick": "{{!!ad.prevent_right_click}}",
                        "draggable": false
                      }
                    },
                    {
                      "type": "basic",
                      "name": "Img",
